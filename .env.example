# ---------------------------------------------------------------------
# Site origin
# Used for canonical URLs, Open Graph / Twitter cards, sitemap.xml,
# robots.txt and JSON-LD. Replace with the real domain (no trailing
# slash) before deploying — the placeholder is rejected in production.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------------
# Contact form delivery (optional — pick ONE provider)
# The form never fakes success: with nothing configured it shows an
# honest "message could not be sent" state with direct contact links.
# ---------------------------------------------------------------------

# Option A — generic webhook. Any endpoint that accepts a JSON POST.
CONTACT_WEBHOOK_URL=

# Option B — Resend (only used when CONTACT_WEBHOOK_URL is empty).
RESEND_API_KEY=
CONTACT_TO_EMAIL=saifulislamnyt@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
